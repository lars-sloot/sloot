# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=keep-this-server-side-only
OPENAI_API_KEY=keep-this-server-side-only
OPENAI_VISION_MODEL=gpt-5-mini
CRON_SECRET=generate-a-random-server-side-secret

# App emails (server-side only). Configure separately in Supabase for Auth emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=pakbonnen@example.com
SMTP_PASSWORD=keep-this-server-side-only
SMTP_SECURE=false
EMAIL_FROM="Sloot pakbonnen <pakbonnen@example.com>"
NEXT_PUBLIC_APP_URL=https://sloot-pakbonnen.vercel.app
